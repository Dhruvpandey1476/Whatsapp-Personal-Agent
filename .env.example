# Copy to .env. With WHATSAPP_ACCESS_TOKEN empty the app runs in MOCK mode (nothing is sent to Meta).
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- WhatsApp Cloud API (developers.facebook.com -> your app -> WhatsApp -> API Setup)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=change-me-verify-token
WHATSAPP_API_VERSION=v25.0

# --- Internal REST API key (X-API-Key header)
API_KEY=dev-api-key
DATABASE_URL=sqlite+aiosqlite:///./agent.db

# --- Agent (Claude). Required: the agent replies with a warning without it.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# --- Checkout: public URL where /pay/<token> is reachable (your ngrok https URL)
PUBLIC_BASE_URL=http://localhost:8000
MAX_ORDER_AMOUNT=25000
PAYMENT_LINK_MINUTES=15
TIMEZONE=Asia/Kolkata
