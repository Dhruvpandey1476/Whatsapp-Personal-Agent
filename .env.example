# Copy to .env. With WHATSAPP_ACCESS_TOKEN empty the app runs in MOCK mode (nothing is sent to Meta).
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- WhatsApp Cloud API (developers.facebook.com -> your app -> WhatsApp -> API Setup)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=change-me-verify-token
WHATSAPP_API_VERSION=v25.0

# --- Internal REST API key (X-API-Key header)
API_KEY=dev-api-key
DATABASE_URL=sqlite+aiosqlite:///./agent.db

# --- Agent LLM: gemini | groq | openrouter (all OpenAI-compatible, swap freely)
# Keys: aistudio.google.com/apikey · console.groq.com/keys · openrouter.ai/keys
LLM_PROVIDER=gemini
LLM_API_KEY=
# Optional: leave empty for provider default (gemini-3-flash-preview / llama-3.3-70b-versatile / google/gemini-2.5-flash)
LLM_MODEL=
# Used once when the main model hits its rate limit (free tiers are small)
LLM_FALLBACK_MODEL=gemini-3-flash-preview,gemini-flash-lite-latest
# Optional: fall back to a DIFFERENT provider (recommended: main=groq, fallback=gemini)
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_API_KEY=

# --- Voice notes: Groq Whisper. Defaults to the Groq key above, so it's usually not needed
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo

# --- Web search (optional). Without it: DuckDuckGo -> Google News -> Wikipedia
TAVILY_API_KEY=

# --- Checkout: public URL where /pay/<token> is reachable (your ngrok https URL)
# Empty on Render (uses RENDER_EXTERNAL_URL automatically)
PUBLIC_BASE_URL=
MAX_ORDER_AMOUNT=200000
PAYMENT_LINK_MINUTES=15
TIMEZONE=Asia/Kolkata

# --- Browser agent (optional, run locally): pip install -r requirements-browser.txt && playwright install chromium
BROWSER_ENABLED=false
BROWSER_ALLOWED_HOSTS=*
BROWSER_STATE_DIR=./browser_sessions

# scripts/demo.py: after a local demo, point WhatsApp back to your cloud server
DEMO_RESTORE_WEBHOOK_URL=
